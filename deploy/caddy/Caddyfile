# ==============================================================================
# Serv.io / YVS Gateway - Central Reverse Proxy (Caddy)
# Mendukung Valid HTTPS otomatis via sslip.io / nip.io & Domain Resmi
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRODUCTION ENVIRONMENT (Valid Auto HTTPS)
# Akses: https://101.32.127.55.sslip.io atau https://komputerawet.com
# ------------------------------------------------------------------------------
101.32.127.55.sslip.io, 101.32.127.55.nip.io, {$PROD_DOMAIN:komputerawet.com} {
    encode zstd gzip

    # API Backend Serv.io Production
    @api path /api /api/* /uploads/*
    handle @api {
        reverse_proxy yvs-prod-backend:5000
    }

    # Frontend Single Page App Production
    handle {
        reverse_proxy yvs-prod-frontend:80
    }
}

# ------------------------------------------------------------------------------
# 2. STAGING / R&D ENVIRONMENT (Valid Auto HTTPS)
# Akses: https://staging.101.32.127.55.sslip.io atau https://staging.komputerawet.com
# ------------------------------------------------------------------------------
staging.101.32.127.55.sslip.io, staging.101.32.127.55.nip.io, {$STAGING_DOMAIN:staging.komputerawet.com} {
    encode zstd gzip

    # API Backend Serv.io Staging
    @api path /api /api/* /uploads/*
    handle @api {
        reverse_proxy yvs-staging-backend:5000
    }

    # Frontend Single Page App Staging
    handle {
        reverse_proxy yvs-staging-frontend:80
    }
}

# ------------------------------------------------------------------------------
# 3. AUTO-REDIRECT JIKA AKSES VIA IP MENTAH
# Mengarahkan langsung ke URL HTTPS resmi ber-gembok hijau
# ------------------------------------------------------------------------------
http://101.32.127.55 {
    redir https://101.32.127.55.sslip.io{uri} permanent
}

https://101.32.127.55 {
    tls internal
    redir https://101.32.127.55.sslip.io{uri} permanent
}
