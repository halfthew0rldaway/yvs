# ==============================================================================
# Serv.io Environment Variables - STAGING (staging.komputerawet.com)
# ==============================================================================

APP_ENV=staging
STAGING_DOMAIN=staging.komputerawet.com

# MySQL Database Staging (Isolasi total dari production)
MYSQL_DATABASE=yvs_staging
MYSQL_USER=yvs_staging
MYSQL_PASSWORD=change_this_staging_password_secure
MYSQL_ROOT_PASSWORD=change_this_staging_root_password_secure
MYSQL_HOST_PORT=3307

# JWT Secret untuk otentikasi Staging
JWT_SECRET=change_this_staging_jwt_secret_key_minimum_32_characters

# Kredensial Akun Owner Staging (Opsional, ada default aman)
STAGING_OWNER_ARNI_PASSWORD=ownerArni2026!
STAGING_OWNER_VIVERO_PASSWORD=ownerVivero2026!
