generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  nama       String
  email      String   @unique
  password   String
  role                   String    @default("teknisi") // admin | teknisi | pimpinan
  reset_password_token   String?   @db.VarChar(255)
  reset_password_expires DateTime?
  created_at             DateTime  @default(now())

  tiket_servis TiketServis[] @relation("TeknisiTiket")
  activity_logs ActivityLog[]
  restock_logs  RestockLog[]
  repair_wikis  RepairWiki[]
  notifications_received Notification[] @relation("NotificationRecipient")
  notifications_sent     Notification[] @relation("NotificationSender")
}

model Customer {
  id            Int      @id @default(autoincrement())
  nama          String
  nomor_telepon String
  alamat        String?
  tipe_kepribadian String?  @default("Netral") // Netral, Koleris, Sanguinis, Plegmatis, Melankolis
  catatan_khusus   String?  @db.Text
  created_at    DateTime @default(now())

  perangkat         Perangkat[]
  peminjaman_loaner LoanerRecord[]
}

model Perangkat {
  id              Int      @id @default(autoincrement())
  customer_id     Int
  jenis_perangkat String
  merek           String
  model           String
  serial_number   String?
  created_at      DateTime @default(now())

  customer     Customer     @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  tiket_servis TiketServis[]
}

model TiketServis {
  id             Int      @id @default(autoincrement())
  nomor_tiket    String   @unique
  perangkat_id   Int
  teknisi_id     Int?
  keluhan        String   @db.Text
  kelengkapan    String?  @db.Text
  foto_kondisi   Json?
  status         String   @default("diterima") // diterima, didiagnosis, menunggu_persetujuan, disetujui, dalam_perbaikan, selesai, diambil, dibatalkan
  created_at     DateTime @default(now())
  completed_at   DateTime?
  kategori_perbaikan String? @default("Umum")
  durasi_garansi     String? @default("1 Bulan")
  tgl_diambil        DateTime?
  last_reminder_sent Int @default(0)

  // Feature: Post-Service Care Tips from Technician
  tips_perawatan     String?  @db.Text

  // Feature: Structured Deposited Accessories Checklist
  kelengkapan_detail Json?
  
  // Feature 1: Warranty Claim
  is_garansi_claim   Boolean   @default(false)
  parent_tiket_id    Int?
  parent_tiket       TiketServis?  @relation("WarrantyClaims", fields: [parent_tiket_id], references: [id], onDelete: SetNull)
  child_claims       TiketServis[] @relation("WarrantyClaims")

  // Feature 2: Intake & QC Inspection Checklists
  checklist_intake   Json?     // Physical intake checklist during drop-off
  checklist_qc       Json?     // Quality control checklist before completion

  // Feature 4: Device Credential Vault / PIN & Lock
  tipe_kunci          String?   @default("Tidak Ada") // Tidak Ada, PIN, Password, Pola Kunci
  password_perangkat  String?   @db.VarChar(255)

  // Feature SOP: Permission & Privasi Pelanggan (Bab 9)
  izin_bongkar        Boolean   @default(true)
  izin_akses_os       Boolean   @default(true)
  izin_backup_mandiri Boolean   @default(true)
  batasan_izin        String?   @db.VarChar(255)

  // Feature SOP: Pengecekan Tahap Awal & Prioritas (Bab 5 & 8)
  kondisi_fisik       String?   @default("Bersih") // Bersih, Kotor, Ada yang Rusak, Pecah
  spesifikasi_awal    String?   @db.Text
  prioritas_pelanggan String?   @default("Standar") // Standar, Data Aman, Cepat Selesai, Biaya Hemat

  // Feature 9: Real-time Warranty Expiry Tracker
  garansi_berakhir_at DateTime?

  // Feature 6: Customer Rating & Store Link
  rating_teknisi       Int?      // 1-5 Star rating given by customer
  rating_submitted_at DateTime?

  // Feature 1: Interactive 2D Visual Scratch & Defect Mapper
  defect_map          Json?     // Array of visual defect markers on device surfaces

  // Feature 7: Dual-Phase SLA Engine (SLA Pengecekan & SLA Pengerjaan Servis)
  sla_paket            String?   @default("reguler") // express, reguler, kompleks
  target_pengecekan_at DateTime? // Batas waktu pengecekan / diagnosis awal
  target_selesai_at    DateTime? // Batas waktu pengerjaan servis fisik (dihitung setelah disetujui customer)
  disetujui_at         DateTime? // Waktu penawaran di-ACC oleh pelanggan (titik awal SLA servis)

  perangkat         Perangkat          @relation(fields: [perangkat_id], references: [id], onDelete: Cascade)
  teknisi           User?              @relation("TeknisiTiket", fields: [teknisi_id], references: [id], onDelete: SetNull)
  diagnosis         Diagnosis?
  log_perbaikan     LogPerbaikan[]
  penggunaan_sparepart PenggunaanSparepart[]
  invoice           Invoice?
  peminjaman_loaner LoanerRecord[]
  supplier_rma      SupplierRma[]
}

model Diagnosis {
  id              Int      @id @default(autoincrement())
  tiket_id        Int      @unique
  masalah         String
  solusi          String
  estimasi_biaya  Float
  created_at      DateTime @default(now())

  tiket TiketServis @relation(fields: [tiket_id], references: [id], onDelete: Cascade)
}

model LogPerbaikan {
  id         Int      @id @default(autoincrement())
  tiket_id   Int
  fase       String   @default("Diagnosis")
  catatan    String
  foto_url   String?  @db.LongText
  created_at DateTime @default(now())

  tiket TiketServis @relation(fields: [tiket_id], references: [id], onDelete: Cascade)
}

model Brand {
  id         Int      @id @default(autoincrement())
  nama       String   @unique
  created_at DateTime @default(now())

  spareparts   Sparepart[]
  repair_wikis RepairWiki[]
}

model Sparepart {
  id         Int      @id @default(autoincrement())
  brand_id   Int?
  kategori   String   @default("Umum") // Laptop, Desktop, Printer, Umum
  nama       String
  stok       Int      @default(0)
  harga_beli Float    @default(0) // Harga modal / HPP
  harga      Float    // Harga jual
  created_at DateTime @default(now())

  brand      Brand?   @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  penggunaan_sparepart PenggunaanSparepart[]
  restock_logs         RestockLog[]
  supplier_rma         SupplierRma[]
}

model PenggunaanSparepart {
  id           Int @id @default(autoincrement())
  tiket_id     Int
  sparepart_id Int
  jumlah       Int

  tiket     TiketServis @relation(fields: [tiket_id], references: [id], onDelete: Cascade)
  sparepart Sparepart   @relation(fields: [sparepart_id], references: [id], onDelete: Cascade)

  @@unique([tiket_id, sparepart_id])
}

model RestockLog {
  id             Int       @id @default(autoincrement())
  sparepart_id   Int
  supplier_nama  String?   @db.VarChar(255)
  jumlah_masuk   Int
  harga_beli_pcs Float
  nomor_faktur   String?   @db.VarChar(255)
  tanggal_beli   DateTime  @default(now())
  catatan        String?   @db.Text
  user_id        Int?
  user_nama      String?   @db.VarChar(255)
  created_at     DateTime  @default(now())

  sparepart      Sparepart @relation(fields: [sparepart_id], references: [id], onDelete: Cascade)
  user           User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)
}

model Invoice {
  id              Int      @id @default(autoincrement())
  tiket_id        Int      @unique
  biaya_jasa      Float
  biaya_sparepart Float
  total_biaya     Float
  created_at      DateTime @default(now())

  tiket TiketServis @relation(fields: [tiket_id], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  user_nama  String
  action     String
  entity     String?
  created_at DateTime @default(now())

  user       User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
}

// Feature 6: Internal Repair Wiki & Hardware Knowledge Base
model RepairWiki {
  id                Int       @id @default(autoincrement())
  brand_id          Int?
  merek             String?   @db.VarChar(100)
  model_seri        String?   @db.VarChar(150)
  kategori          String    @default("Motherboard / Power") // Motherboard, Layar / Display, Keyboard & Touchpad, Kipas & Thermal, Storage & OS, Lainnya
  judul             String    @db.VarChar(255)
  gejala            String    @db.Text
  penyebab          String?   @db.Text
  solusi_langkah    String    @db.Text
  komponen_terkait  String?   @db.VarChar(255)
  tingkat_kesulitan String    @default("Menengah") // Mudah, Menengah, Mahir, Spesialis
  estimasi_waktu    String?   @default("1-2 Jam")
  tingkat_sukses    Int?      @default(90)
  sumber_tiket_id   Int?
  user_id           Int?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  brand             Brand?    @relation(fields: [brand_id], references: [id], onDelete: SetNull)
  user              User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)
}

// Fitur Notifikasi & Memo Kolaborasi Teknisi - Admin
model Notification {
  id             Int      @id @default(autoincrement())
  recipient_role String?  @db.VarChar(50) // admin, teknisi, or null (semua)
  user_id        Int?     // target spesifik user_id jika ada
  sender_id      Int?     // pengirim notifikasi
  sender_nama    String   @db.VarChar(255)
  tipe           String   @default("info") @db.VarChar(50) // restock_sparepart, tiket, memo, system
  judul          String   @db.VarChar(255)
  pesan          String   @db.Text
  link           String?  @db.VarChar(255)
  is_read        Boolean  @default(false)
  created_at     DateTime @default(now())

  user   User? @relation("NotificationRecipient", fields: [user_id], references: [id], onDelete: Cascade)
  sender User? @relation("NotificationSender", fields: [sender_id], references: [id], onDelete: SetNull)
}

// Feature 6: Unit Pinjaman / Loaner & Backup Device Pool
model LoanerDevice {
  id              Int            @id @default(autoincrement())
  kode_unit       String         @unique @db.VarChar(50) // e.g. "LOAN-01", "TP-T480-A"
  nama            String         @db.VarChar(150) // e.g. "Lenovo ThinkPad T480"
  kategori        String         @default("Laptop") // Laptop, Smartphone, Tablet, PC
  serial_number   String?        @db.VarChar(100)
  spesifikasi     String?        @db.Text // e.g. "Core i5 8th Gen, RAM 16GB, SSD 256GB"
  kelengkapan     String?        @db.VarChar(255) // e.g. "Unit + Charger Type-C 65W + Tas"
  kondisi_fisik   String?        @default("Mulus / Normal") @db.VarChar(255)
  status          String         @default("tersedia") // tersedia, dipinjam, dalam_perawatan
  catatan         String?        @db.Text
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  pinjaman        LoanerRecord[]
}

model LoanerRecord {
  id                      Int           @id @default(autoincrement())
  loaner_device_id        Int
  tiket_id                Int
  customer_id             Int
  nomor_peminjaman        String        @unique @db.VarChar(50) // e.g. "LNR-2026-0001"
  tanggal_pinjam          DateTime      @default(now())
  estimasi_kembali        DateTime?
  tanggal_kembali         DateTime?
  status                  String        @default("aktif") // aktif, dikembalikan
  deposit_uang            Float         @default(0) // Uang jaminan
  deposit_dikembalikan    Boolean       @default(false) // Status pengembalian deposit
  catatan_kondisi_pinjam  String?       @db.Text
  catatan_kondisi_kembali String?       @db.Text
  syarat_ketentuan_acc    Boolean       @default(true)
  created_by_nama         String?       @db.VarChar(100)
  diterima_kembali_nama   String?       @db.VarChar(100)
  created_at              DateTime      @default(now())
  updated_at              DateTime      @updatedAt

  loaner_device           LoanerDevice  @relation(fields: [loaner_device_id], references: [id], onDelete: Restrict)
  tiket                   TiketServis   @relation(fields: [tiket_id], references: [id], onDelete: Cascade)
  customer                Customer      @relation(fields: [customer_id], references: [id], onDelete: Cascade)
}

// Feature 7: Supplier Part Warranty & RMA Tracker (Klaim Garansi Distributor)
model SupplierRma {
  id                  Int          @id @default(autoincrement())
  nomor_rma           String       @unique @db.VarChar(50) // e.g. "RMA-2026-0001"
  sparepart_id        Int
  supplier_nama       String       @db.VarChar(150) // Distributor / Toko (e.g. Toko LCD Bandung, Supplier Mangga Dua)
  nomor_faktur        String?      @db.VarChar(100) // Nomor nota pembelian awal
  jumlah              Int          @default(1)
  alasan_rusak        String       @db.Text // Gejala defek (LCD bergaris, IC short, Baterai drop)
  foto_kondisi        Json?        // Foto bukti cacat sparepart
  status              String       @default("diajukan") // diajukan, dikirim, disetujui_ganti, disetujui_refund, ditolak
  resi_pengiriman     String?      @db.VarChar(100) // Nomor resi kurir
  kurir_pengiriman    String?      @db.VarChar(100) // JNE, J&T, SiCepat, dll
  ongkir              Float?       @default(0)
  solusi_distributor  String?      @db.VarChar(100) // "Ganti Unit Baru", "Refund Dana", "Ditolak / Void"
  catatan_distributor String?      @db.Text
  tgl_pengajuan       DateTime     @default(now())
  tgl_selesai         DateTime?
  tiket_id            Int?         // Tiket servis sumber ditemukannya defek
  created_by_nama     String?      @db.VarChar(100)
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  sparepart           Sparepart    @relation(fields: [sparepart_id], references: [id], onDelete: Restrict)
  tiket               TiketServis? @relation(fields: [tiket_id], references: [id], onDelete: SetNull)
}

