# ==============================================================================
# Serv.io Environment Variables - PRODUCTION (komputerawet.com)
# ==============================================================================

APP_ENV=production
PROD_DOMAIN=komputerawet.com

# MySQL Database Production (Data riil operasional bengkel)
MYSQL_DATABASE=yvs_production
MYSQL_USER=yvs_prod
MYSQL_PASSWORD=change_this_prod_password_secure
MYSQL_ROOT_PASSWORD=change_this_prod_root_password_secure
MYSQL_HOST_PORT=3306

# JWT Secret untuk otentikasi Production
JWT_SECRET=change_this_prod_jwt_secret_key_minimum_32_characters
