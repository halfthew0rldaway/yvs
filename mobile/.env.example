# ==============================================================================
# Serv.io Companion - CONTOH KONFIGURASI ENVIRONMENT
# ==============================================================================
# Salin file ini menjadi `.env` lalu sesuaikan nilainya:
#   cp .env.example .env
# JANGAN commit `.env` yang berisi kredensial environment nyata.
# ==============================================================================

# Environment aktif: staging | production | development
APP_ENV=staging

# Base URL API (WAJIB diakhiri /api)
API_BASE_URL=https://staging.101.32.127.55.sslip.io/api

# Origin publik untuk resolve URL gambar/upload (tanpa suffix /api)
API_ASSET_BASE_URL=https://staging.101.32.127.55.sslip.io

# Timeout jaringan (detik)
API_CONNECT_TIMEOUT=30
API_RECEIVE_TIMEOUT=30